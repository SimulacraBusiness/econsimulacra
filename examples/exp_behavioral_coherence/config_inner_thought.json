{
    "simulation": {
        "numSteps": 169,
        "parallelBatchSize": 64,
        "events": ["constantSalary", "constantSupply"]
    },
    "environment": {
        "space": "gridSpace",
        "socialNetwork": "socialNetwork",
        "cashName": "Yen",
        "agents": [
            "Retailer", "lowRestaurant", "medRestaurant", "highRestaurant",
            "Household"
        ],
        "items": [
            "Yen",
            "Rice", "Eggs", "Milk", "Bread", "Cooking oil",
            "Tomatoes", "Cheese", "Chicken", "Beef",
