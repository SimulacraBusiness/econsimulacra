    "promptBuilder": {
        "type": "NameBasedPromptBuilder",
        "name2SimulationDescriptionPath": {
            "others": "simulation_description_retailers.txt",
            "Household": "simulation_description_households.txt"
        }
    },
    "llmClient": {
        "type": "VLLMClient",
        "modelName": "openai/gpt-oss-120b",
        "other_choice": "hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4, Qwen/Qwen3.6-35B-A3B, openai/gpt-oss-20b, Qwen/Qwen2.5-7B-Instruct, meta-llama/Meta-Llama-3-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3",
        "vllmPython": "/home/m2023rhashimoto/econsimulacra/.venv-vllm/bin/python",
        "useGpu": true,
        "gpuIds": [0,1],
        "isDataParallel": false,
        "host": "127.0.0.1",
        "port": 8000,
        "timeOut": 600,
        "maxRetries": 3,
        "serverStartTimeout": 1200,
        "maxConcurrentGenerations": 32,
        "trustRemoteCode": false,
	    "maxModelLen": 65536,
        "gpuMemoryUtilization": 0.8,
        "gridSpace": [10, 10],
        "items": [
            "Yen", "Rice", "Pizza", "Soda",
            "Soup", "Bread", "Salad"
        ],
        "numAgents": 32
    },
    "timeTranslator": {
        "type": "TimeTranslator",
        "numSteps": 216,
        "startDatetime": "2025-12-19 09:00:00",
        "endDatetime": "2025-12-28 09:00:00"
    },
    "sleepManager": {
        "type": "SleepManager"
    },
    "memoryHandler": {
        "type": "MemoryHandler",
        "memoryLength": 24,
        "numObs": 24,
        "memorySummarizer": {
            "type": "StressAwareSummarizer",
            "relativeThresholdForPriceChange": 0.01,
            "stressCalculator": {
                "type": "StressCalculator",
                "stressTypes": [
                    "sleep_history",
                    "consumption_history",
                    "move_history",
                    "state_evaluation_history",
                    "obs_history"
                ],
                "item2Weight": {
                    "Yen": 0.0,
                    "Rice": 3.0,
                    "Soda": 0.1,
                    "Pizza": 3.0,
                    "Soup": 1.0,
                    "Bread": 2.0,
                    "Salad": 1.5
                },
                "maxMagnitude": 100,
                "targetSleepDuration": 16.0,
                "windowSizeForSleep": 48,
                "durationWeightForSleep": 0.5,
                "regularityWeightForSleep": 0.5,
                "targetConsumptionQuantity": 10,
                "windowSizeForConsumption": 24,
                "timeDecayForConsumption": 0.9,
                "targetMoveDistance": 15.0,
                "windowSizeForMove": 24,
                "timeDecayForMove": 0.95,
                "homeComfortWeight": 0.4,
                "windowSizeForStateEvaluation": 5,
                "buyingPowerWeight": 1.5,
                "relativeWealthWeight": 0.9,
                "wealthDrawdownWeight": 0.3,
                "targetNumNearby": 4,
                "toleranceThresholdForStress": 50
            }
        }
    },
    "provideSubsidy": {
        "type": "SubsidyEvent",
        "trigger": {
            "every": 24
        },
        "subsidyAmount": 5000
    },
    "constantSupply": {
        "type": "ConstantSupply",
        "trigger": {
            "with": ["AgentGenerationLog"],
            "every": 6
        },
        "suppliedAgentNames": ["Daily Mart", "BestValue Grocery", "Pizza Place"]
    },
    "animation": {
        "cellSize": 1,
        "drawMarginCells": 2,
        "maxTweetsInTL": 13,
        "fastRendering": true
    }
}
