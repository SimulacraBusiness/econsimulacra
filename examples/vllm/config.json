{
    "simulation": {
        "numSteps": 72,
        "parallelBatchSize": 4
    },
    "environment": {
        "space": "gridSpace",
        "socialNetwork": "socialNetwork",
        "cashName": "Yen",
        "agents": ["Household", "Retailer", "Restaurant"],
        "items": ["Yen", "Rice", "Pizza"],
        "service": ["promptBuilder", "llmClient", "timeTranslator", "personaBuilder", "memoryHandler"]
    },
    "gridSpace": {
        "type": "GridSpace",
        "gridSize": [50, 50]
    },
    "socialNetwork": {
        "type": "SocialNetwork",
        "followCap": 3,
        "recSys": {
            "type": "TwoHopRecommenderSystem",
            "maxRecommendations": 2,
            "isRandomized": true,
            "temperature": 0.4
        }
    },
    "Household": {
        "type": "LLMAgent",
        "isHousehold": true,
        "numAgents": 118,
        "inventory": {
            "Yen": [100000, 200000],
            "Rice": [3, 10],
            "Pizza": 0
        },
        "svgPath": "../../imgs/human.svg",
        "iconScale": 0.2
    },
    "Retailer": {
        "type": "LLMAgent",
        "isRichInfoAllowed": true,
        "isHousehold": false,
        "initialCoords": [15, 25],
        "numAgents": 1,
        "inventory": {
            "Yen": 1000000,
            "Rice": 10000,
            "Pizza": 0
        },
        "provideInfo4CoLocatedAgents": ["inventory"],
        "provideInfo4AllAgents": ["self_pos"],
        "svgPath": "../../imgs/store.svg",
        "iconScale": 0.2
    },
    "Restaurant": {
        "type": "LLMAgent",
        "isRichInfoAllowed": true,
        "isHousehold": false,
        "initialCoords": [35, 25],
        "numAgents": 1,
        "inventory": {
            "Yen": 1000000,
            "Pizza": 10000,
            "Rice": 0
        },
        "provideInfo4CoLocatedAgents": ["inventory"],
        "provideInfo4AllAgents": ["self_pos"],
        "svgPath": "../../imgs/store.svg",
        "iconScale": 0.2
    },
    "Yen": {
        "type": "Item",
        "initialPrice": 1.0
    },
    "Rice": {
        "type": "Item",
        "initialPrice": 1000.0
    },
    "Pizza": {
        "type": "Item",
        "initialPrice": 1500.0
    },
    "promptBuilder": {
        "type": "PromptBuilder"
    },
    "llmClient": {
        "type": "VLLMClient",
        "modelName": "meta-llama/Meta-Llama-3-8B-Instruct",
        "other_choice": "Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3",
        "vllmPython": "path_to_venv_vllm/econsimulacra/.venv-vllm/bin/python",
        "useGpu": true,
        "gpuIds": [0, 1],
        "isDataParallel": true,
        "host": "127.0.0.1",
        "port": 8000,
        "timeOut": 60,
        "maxRetries": 3,
        "serverStartTimeout": 300,
        "maxConcurrentGenerations": 32,
        "trustRemoteCode": false,
        "gpuMemoryUtilization": 0.9,
        "modifySchema": true,
        "gridSpace": [50, 50],
        "items": ["Yen", "Rice", "Pizza"],
        "numAgents": 120
    },
    "timeTranslator": {
        "type": "TimeTranslator",
        "numSteps": 72,
        "startDatetime": "2025-10-11 09:00:00",
        "endDatetime": "2025-10-12 21:00:00"
    },
    "personaBuilder": {
        "type": "Big5PersonaBuilder",
        "maxMagnitude": 3
    },
    "memoryHandler": {
        "type": "MemoryHandler",
        "memoryLength": 5
    },
    "animation": {
        "cellSize": 1,
        "drawMarginCells": 2,
        "maxTweetsInTL": 5,
        "fastRendering": true
    }
}
