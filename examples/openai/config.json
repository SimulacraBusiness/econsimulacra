{
    "simulation": {
        "numSteps": 72
    },
    "environment": {
        "gridSpace": [10, 10],
        "followCap": 3,
        "cashName": "Yen",
        "agents": ["Household", "Retailer", "Restaurant"],
        "items": ["Yen", "Rice", "Pizza"],
        "service": ["promptBuilder", "llmClient", "timeTranslator", "personaBuilder", "memoryHandler"]
    },
    "Household": {
        "type": "LLMAgent",
        "isHousehold": true,
        "numAgents": 8,
        "inventory": {
            "Yen": [100000, 200000],
            "Rice": [3, 10],
            "Pizza": 0
        },
        "svgPath": "../../imgs/human.svg",
        "iconScale": 0.2
    },
    "Retailer": {
        "type": "LLMAgent",
        "isRichInfoAllowed": true,
        "isHousehold": false,
        "initialCoords": [3, 5],
        "numAgents": 1,
        "inventory": {
            "Yen": 100000,
            "Rice": 1000,
            "Pizza": 0
        },
        "provideInfo4CoLocatedAgents": ["inventory"],
        "provideInfo4AllAgents": ["self_pos"],
        "svgPath": "../../imgs/store.svg",
        "iconScale": 0.2
    },
    "Restaurant": {
        "type": "LLMAgent",
        "isRichInfoAllowed": true,
        "isHousehold": false,
        "initialCoords": [8, 5],
        "numAgents": 1,
        "inventory": {
            "Yen": 100000,
            "Pizza": 1000,
            "Rice": 0
        },
        "provideInfo4CoLocatedAgents": ["inventory"],
        "provideInfo4AllAgents": ["self_pos"],
        "svgPath": "../../imgs/store.svg",
        "iconScale": 0.2
    },
    "Yen": {
        "type": "Item",
        "initialPrice": 1.0
    },
    "Rice": {
        "type": "Item",
        "initialPrice": 1000.0
    },
    "Pizza": {
        "type": "Item",
        "initialPrice": 1500.0
    },
    "promptBuilder": {
        "type": "PromptBuilder"
    },
    "llmClient": {
        "type": "OpenAIClient",
        "modelName": "gpt-4o-mini",
        "modifySchema": true
    },
    "timeTranslator": {
        "type": "TimeTranslator",
        "numSteps": 72,
        "startDatetime": "2025-10-11 09:00:00",
        "endDatetime": "2025-10-12 21:00:00"
    },
    "personaBuilder": {
        "type": "Big5PersonaBuilder",
        "maxMagnitude": 3
    },
    "memoryHandler": {
        "type": "MemoryHandler",
        "memoryLength": 5
    },
    "animation": {
        "cellSize": 1,
        "drawMarginCells": 2,
        "maxTweetsInTL": 5,
        "fastRendering": true
    }
}